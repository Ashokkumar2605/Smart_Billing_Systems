package com.example.Smart_Billing_System_.service;

import com.example.Smart_Billing_System_.entity.Order;
import com.example.Smart_Billing_System_.repository.OrderRepository;
import org.springframework.stereotype.Service;

import java.time.LocalDateTime;
import java.util.List;

@Service
public class OrderService {

    private final OrderRepository repo;

    public OrderService(OrderRepository repo) {
        this.repo = repo;
    }

    public Order saveOrder(Order order) {
        order.setOrderDate(LocalDateTime.now());
        return repo.save(order);
    }

    public List<Order> getMonthlyOrders(int year, int month) {
        LocalDateTime start = LocalDateTime.of(year, month, 1, 0, 0);
        LocalDateTime end = start.plusMonths(1);
        return repo.findByOrderDateBetween(start, end);
    }
}
