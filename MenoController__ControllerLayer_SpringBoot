package com.example.Smart_Billing_System_.controller;

import com.example.Smart_Billing_System_.entity.MenuItem;
import com.example.Smart_Billing_System_.service.MenuService;
import org.springframework.web.bind.annotation.*;

import java.util.List;

@RestController
@RequestMapping("/api/menu")
@CrossOrigin
public class MenuController {

    private final MenuService service;

    public MenuController(MenuService service) {
        this.service = service;
    }

    @GetMapping
    public List<MenuItem> getAll() {
        return service.getAllItems();
    }

    @PostMapping
    public MenuItem add(@RequestBody MenuItem item) {
        return service.saveItem(item);
    }

    @PutMapping("/{id}")
    public MenuItem update(@PathVariable Long id, @RequestBody MenuItem item) {
        item.setId(id);
        return service.saveItem(item);
    }

    @DeleteMapping("/{id}")
    public void delete(@PathVariable Long id) {
        service.deleteItem(id);
    }
}
